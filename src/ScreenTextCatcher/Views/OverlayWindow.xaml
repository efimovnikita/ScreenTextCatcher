<Window x:Class="ScreenTextCatcher.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#80000000"
        Focusable="True">

    <Window.Resources>
        <DropShadowEffect x:Key="ToolbarShadow" BlurRadius="12" ShadowDepth="3" Opacity="0.5"/>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#555555"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarDoneButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="5" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#388E3C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1B5E20"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Canvas x:Name="OverlayCanvas" Background="Transparent" 
            MouseDown="OnCanvasMouseDown" 
            MouseMove="OnCanvasMouseMove" 
            MouseUp="OnCanvasMouseUp">
        
        <!-- Frozen screen background (used in screenshot mode) -->
        <Image x:Name="FrozenScreenImage" Stretch="Fill" IsHitTestVisible="False" Visibility="Collapsed"/>
        <Rectangle x:Name="DimMask" Fill="#80000000" IsHitTestVisible="False" Visibility="Collapsed"/>

        <!-- Hint text -->
        <Border x:Name="HintBorder" Background="#B0000000" CornerRadius="6" Padding="14,8" Canvas.Top="40">
            <TextBlock Text="{DynamicResource Loc_OverlayHint}" 
                       Foreground="#FFFFFF" FontSize="14" FontFamily="Segoe UI" FontWeight="SemiBold"/>
        </Border>

        <!-- Selection Rectangle (Bright contrasting Red, 1px border) -->
        <Rectangle x:Name="SelectionRect" 
                   Stroke="#FF1744" 
                   StrokeThickness="1" 
                   SnapsToDevicePixels="True"
                   Fill="#12FF1744" 
                   Visibility="Collapsed"/>

        <!-- Annotation Canvas (in-place drawing layer inside selection) -->
        <Canvas x:Name="AnnotationCanvas" 
                Canvas.ZIndex="10"
                ClipToBounds="True" 
                Visibility="Collapsed" 
                IsHitTestVisible="False">
            <Image x:Name="AnnotatedCroppedImage" Stretch="Fill"/>
        </Canvas>

        <!-- Corner Indicators (Thick high-contrast Red brackets) -->
        <Border x:Name="CornerTopLeft" Width="14" Height="14" 
                BorderBrush="#FF1744" BorderThickness="3,3,0,0" Visibility="Collapsed"/>
        <Border x:Name="CornerTopRight" Width="14" Height="14" 
                BorderBrush="#FF1744" BorderThickness="0,3,3,0" Visibility="Collapsed"/>
        <Border x:Name="CornerBottomLeft" Width="14" Height="14" 
                BorderBrush="#FF1744" BorderThickness="3,0,0,3" Visibility="Collapsed"/>
        <Border x:Name="CornerBottomRight" Width="14" Height="14" 
                BorderBrush="#FF1744" BorderThickness="0,0,3,3" Visibility="Collapsed"/>

        <!-- Dimensions badge -->
        <Border x:Name="DimensionBadge" Background="#E6212121" BorderBrush="#FF1744" BorderThickness="1" CornerRadius="4" Padding="6,2" Visibility="Collapsed">
            <TextBlock x:Name="TxtDimensions" Foreground="#FF5252" FontSize="11" FontFamily="Consolas" FontWeight="Bold"/>
        </Border>

        <!-- Floating Annotation Toolbar -->
        <Border x:Name="AnnotationToolbar" 
                Canvas.ZIndex="1000"
                Background="#E6212121" 
                BorderBrush="#444444" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="6,4" 
                Visibility="Collapsed"
                Effect="{StaticResource ToolbarShadow}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Rectangle Tool -->
                <Button x:Name="BtnToolRect" 
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="{DynamicResource Loc_AnnotateToolbarRect}"
                        Click="OnToolRectClick">
                    <TextBlock Text="▢" FontSize="18" FontWeight="Bold" Margin="0,-2,0,0"/>
                </Button>

                <!-- Arrow Tool -->
                <Button x:Name="BtnToolArrow" 
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="{DynamicResource Loc_AnnotateToolbarArrow}"
                        Click="OnToolArrowClick">
                    <TextBlock Text="➔" FontSize="16" FontWeight="Bold"/>
                </Button>

                <Rectangle Width="1" Height="20" Fill="#444444" Margin="6,2"/>

                <!-- Undo Button -->
                <Button x:Name="BtnUndo" 
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="{DynamicResource Loc_AnnotateToolbarUndo}"
                        IsEnabled="False"
                        Click="OnUndoClick">
                    <TextBlock Text="↩" FontSize="16" FontWeight="Bold"/>
                </Button>

                <Rectangle Width="1" Height="20" Fill="#444444" Margin="6,2"/>

                <!-- Copy Image Button -->
                <Button x:Name="BtnCopyImage" 
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="{DynamicResource Loc_AnnotateToolbarCopyTooltip}"
                        Click="OnCopyImageClick"
                        Margin="2,0,4,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📋" FontSize="14" Margin="0,0,4,0"/>
                        <TextBlock Text="{DynamicResource Loc_AnnotateToolbarCopy}" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <!-- Done Button -->
                <Button x:Name="BtnDone" 
                        Style="{StaticResource ToolbarDoneButtonStyle}"
                        ToolTip="{DynamicResource Loc_AnnotateToolbarDone}"
                        Click="OnDoneClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✓" FontSize="15" FontWeight="Bold" Margin="0,0,4,0"/>
                        <TextBlock Text="{DynamicResource Loc_AnnotateToolbarDone}" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <!-- Cancel Button -->
                <Button x:Name="BtnCancel" 
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="{DynamicResource Loc_AnnotateToolbarCancel}"
                        Click="OnCancelClick"
                        Margin="4,0,0,0">
                    <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="#FF5252"/>
                </Button>
            </StackPanel>
        </Border>
    </Canvas>
</Window>
